rules_version = '2';

// ============================================================================
// ZILBERSHLAG — Firestore security rules  (project: asfanut)
// All data lives under zc_* collections. Admin = the site owner (ADMIN_EMAIL)
// or any zc_users doc whose role == 'admin'.
//
// Bidding model: a bidder writes their MAXIMUM bid into
//   zc_lots/<id>/bids/<auto>  { uid, name, maxBid, at }
// A Cloud Function (admin SDK) resolves the public price on the lot document,
// keeping every bidder's maximum private. Clients never write the lot itself.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ADMIN_EMAIL() { return 'aaci.yoni@gmail.com'; }
    function owner() { return signedIn() && request.auth.token.email == ADMIN_EMAIL(); }

    function zcUserPath() { return /databases/$(database)/documents/zc_users/$(request.auth.uid); }
    function zcHasProfile() { return signedIn() && exists(zcUserPath()); }
    function zcProfile() { return get(zcUserPath()).data; }
    function zcAdmin() { return owner() || (zcHasProfile() && zcProfile().role == 'admin'); }
    function zcNotBanned() { return !zcHasProfile() || zcProfile().banned != true; }
    function zcReady() {
      return signedIn() && zcNotBanned() && zcHasProfile() && zcProfile().profileComplete == true;
    }

    function lotData(id) { return get(/databases/$(database)/documents/zc_lots/$(id)).data; }
    function auctionLive(id) {
      let d = lotData(id);
      return d.mode == 'auction'
        && request.time > d.startAt
        && request.time < d.endAt;
    }

    // Public site config (auction schedule etc.), admin-managed.
    match /zc_config/{doc} { allow read: if true; allow write: if zcAdmin(); }

    // Buyer accounts. A user creates and edits ONLY their own profile and can
    // never set their own role or lift their own ban; the admin can do anything.
    match /zc_users/{uid} {
      allow read: if zcAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'bidder'
        && request.resource.data.banned == false;
      allow update: if zcAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.banned == resource.data.banned);
      allow delete: if zcAdmin();
    }

    // Lots — public to read; only the admin (and the server) writes them.
    // Bidders affect a lot only indirectly, by writing a bid below.
    match /zc_lots/{lotId} {
      allow read: if true;
      allow create, update, delete: if zcAdmin();

      // Maximum-bid intents. A bidder may add their own bid on a LIVE auction,
      // at or above the opening price. Bids are read-only afterwards, and a
      // bidder can see only their own (maxima stay private); the admin sees all.
      match /bids/{bidId} {
        allow read: if zcAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if zcReady()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.maxBid is number
          && request.resource.data.maxBid > 0
          && auctionLive(lotId)
          && request.resource.data.maxBid >= lotData(lotId).openingBid;
        allow update, delete: if false;
      }
    }

    // Orders — auction wins (created by the close function via admin SDK) and
    // private-sale reservations (bidder-created). Only the admin marks paid /
    // unpaid or deletes. This is where non-payment is recorded before a ban.
    match /zc_orders/{orderId} {
      allow read: if zcAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if zcAdmin()
        || ( zcReady()
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.type == 'buynow_reservation'
             && request.resource.data.paid == false );
      allow update, delete: if zcAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
